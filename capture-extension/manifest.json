{
  "manifest_version": 3,
  "name": "GitGood Capture",
  "short_name": "GitGood",
  "description": "Capturează pașii dintr-o aplicație web pentru un tichet, doar pe domeniile permise, cu mascare locală.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "GitGood Capture",
    "default_popup": "ui/popup.html"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "downloads", "activeTab", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "minimum_chrome_version": "110"
}
