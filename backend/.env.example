# Copiază acest fișier în backend/.env.local și completează cheile tale.
# .env.local NU se urcă pe GitHub (e în .gitignore). Nu pune niciodată chei reale în acest fișier.
#
#   cp backend/.env.example backend/.env.local

# --- AI (obligatoriu pentru proceduri generate) --------------------------------
# Varianta gratuită: Google Gemini. Cheia se ia de la https://aistudio.google.com/apikey
# (cu un cont Gmail personal; conturile de facultate au adesea Gemini blocat).
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Opțional: modelul principal și rezervele încercate dacă e supraîncărcat.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash

# Alternativă plătită: OpenAI (setează AI_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- Fireflies (opțional, pentru pagina Ședințe) -------------------------------
# Cheia: app.fireflies.ai → Settings → Developer Settings → API Key
# FIREFLIES_API_KEY=
# Demo fără cont Fireflies: node tools/mock-fireflies.mjs și
# FIREFLIES_API_URL=http://localhost:8790/graphql cu FIREFLIES_API_KEY=demo
